# AICTE Verify — Environment Configuration Template

# Server Settings
PROJECT_NAME="AICTE Verify — Application & Compliance Intelligence"
API_V1_STR="/api/v1"
SECRET_KEY="aicte_super_secret_jwt_key_2025_safe_token_dev"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (defaults to local SQLite if unset, or PostgreSQL)
DATABASE_URL="sqlite:///./aicte_verify.db"
# DATABASE_URL="postgresql://aicte_admin:aicte_secure_password_2025@localhost:5432/aicte_verify"

# Storage Settings
STORAGE_TYPE="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=26214400

# S3 Compatible Object Storage (MinIO / AWS S3)
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_BUCKET_NAME="aicte-documents"

# Demonstration & Simulation Flags
DEMO_MODE=true
SIMULATE_SOURCE_DELAYS=true
DATA_RETENTION_DAYS=365
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
